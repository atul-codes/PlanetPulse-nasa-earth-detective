# NASA Earth Systems Trend Detective - Environment Configuration

# 1. NASA Data APIs
# NASA Open APIs (api.nasa.gov) for Earth Imagery, Landsat & EONET:
NASA_API_KEY=your_nasa_open_api_key_here

# NASA POWER requires no key for standard access.
# If using authenticated NASA Earthdata CMR / GES DISC:
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
EARTHDATA_TOKEN=your_earthdata_bearer_token

# 2. Database Connection
# Optional: Set MongoDB connection string for persisting investigations
MONGODB_URI=mongodb://localhost:27017/earth_trend_detective

# 3. Scientific Computing Backend
# Python FastAPI microservice URL (defaults to http://127.0.0.1:8000)
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# 4. Next.js Runtime
NEXT_PUBLIC_APP_NAME="Earth Systems Trend Detective"
NEXT_PUBLIC_APP_VERSION="1.0.0"

